.detail-skeleton__art {
  height: 420rpx;
  border-radius: 34rpx;
}

.detail-skeleton__title {
  width: 72%;
  height: 58rpx;
  margin-top: 30rpx;
}

.detail-skeleton__line {
  height: 28rpx;
  margin-top: 20rpx;
}

.detail-skeleton__line--short {
  width: 46%;
}

.detail-empty__home {
  margin-left: 16rpx;
}

.detail-art {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 420rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #eeede8;
  border: 1rpx solid var(--line);
}

.detail-art__orb {
  display: none;
}

.detail-art__emoji {
  position: relative;
  font-size: 160rpx;
  line-height: 1;
  filter: drop-shadow(0 22rpx 24rpx rgba(31, 56, 44, 0.16));
}

.detail-art__image {
  width: 100%;
  height: 100%;
}

.detail-art__category {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.9);
  color: var(--brand);
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.detail-head {
  margin-top: 30rpx;
}

.detail-title {
  margin-top: 8rpx;
  font-size: 46rpx;
}

.detail-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.detail-yen {
  margin-right: 3rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.detail-desc {
  margin-top: 28rpx;
}

.detail-desc__text {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.8;
  color: var(--ink-soft);
  white-space: pre-wrap;
}

.detail-qty {
  margin-top: 20rpx;
}

.detail-pickup {
  margin-top: 30rpx;
  padding: 20rpx 22rpx;
  border-left: 4rpx solid var(--brand);
  background: var(--surface);
  color: var(--ink-soft);
  font-size: 23rpx;
  line-height: 1.65;
}

.detail-bar {
  gap: 16rpx;
}

.detail-bar__price {
  min-width: 150rpx;
}

.detail-bar__hint {
  margin-top: 2rpx;
  font-size: 19rpx;
  color: var(--muted);
}

.detail-bar__cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 10rpx;
  background: var(--surface-soft);
}

.detail-bar__cart--hover {
  background: var(--surface-deep);
}

.detail-bar__cart-icon {
  font-size: 30rpx;
  line-height: 1;
}

.detail-bar__cart-label {
  margin-top: 2rpx;
  font-size: 17rpx;
  color: var(--ink-soft);
}

.detail-bar__btn {
  flex: 1;
  height: 88rpx;
}
