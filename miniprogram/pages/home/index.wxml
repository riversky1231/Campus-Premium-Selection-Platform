<view class="wrap"><view class="eyebrow">CAMPUS / DAILY GOODS</view><view class="row"><view class="title">把小日子<view>装进购物袋。</view></view><view><text bindtap="cart" class="muted">购物车 · </text><text bindtap="orders" class="muted">订单 · </text><text bindtap="admin" class="muted">管理 ↗</text></view></view><view class="hero"><view style="font-size:38rpx;font-weight:bold">课间好物 · 顺路自提</view><view class="muted" style="margin-top:18rpx">零食、饮品、日用品，一站选好。</view></view><input placeholder="搜索今天想买的好物" confirm-type="search" bindconfirm="search"/><scroll-view scroll-x="true" class="chips"><text class="chip {{categoryId==''?'active':''}}" data-id="" bindtap="category">全部</text><text wx:for="{{categories}}" wx:key="id" class="chip {{categoryId==item.id?'active':''}}" data-id="{{item.id}}" bindtap="category">{{item.name}}</text></scroll-view><view class="grid"><view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail"><view class="art">{{item.categoryId==1?'🥨':item.categoryId==2?'🍋':'🧺'}}</view><view class="name">{{item.name}}</view><view class="stock">库存 {{item.stock}} 件</view><view class="price">¥{{item.price}}</view></view></view><view wx:if="{{loading}}" class="empty">正在挑选好物…</view><button wx:if="{{error}}" bindtap="retry">加载失败，点击重试</button><view wx:if="{{!loading && !error && !items.length}}" class="empty">暂时没有找到商品</view><button wx:if="{{hasMore}}" class="secondary" bindtap="more" loading="{{loading}}">再看一些</button><view class="footer">校园优选 / 好物就在身边</view></view>
