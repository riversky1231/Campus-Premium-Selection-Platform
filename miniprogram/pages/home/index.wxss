.home {
  padding-top: 18rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.brand__name {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.brand__meta {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.quick {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.quick__btn {
  position: relative;
  padding: 12rpx 0 12rpx 8rpx;
  color: var(--ink-soft);
}

.quick__btn--hover {
  opacity: 0.65;
}

.quick__label {
  font-size: 22rpx;
}

.quick__badge {
  position: absolute;
  top: -4rpx;
  right: -16rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 14rpx;
  background: var(--danger);
  color: #fff;
  font-size: 17rpx;
  line-height: 28rpx;
  text-align: center;
}

.home-intro {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
  background: #fff0e8;
}

.home-intro__label {
  flex-shrink: 0;
  color: var(--brand-deep);
  font-size: 23rpx;
  font-weight: 700;
}

.home-intro__desc {
  font-size: 22rpx;
  color: var(--muted);
}

.search {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 0 10rpx 0 22rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid var(--brand);
}

.search__icon {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  border: 3rpx solid #8c918b;
  border-radius: 50%;
}

.search__icon::after {
  position: absolute;
  right: -9rpx;
  bottom: -5rpx;
  width: 11rpx;
  height: 3rpx;
  background: #8c918b;
  content: '';
  transform: rotate(45deg);
}

.search__input {
  flex: 1;
  height: 80rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.search__clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  color: var(--muted);
  font-size: 22rpx;
}

.search__submit {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 62rpx;
  min-width: 92rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.chips {
  margin-top: 16rpx;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx 18rpx;
}

.product {
  overflow: hidden;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  transition: opacity 0.16s ease;
}

.product--hover {
  opacity: 0.78;
}

.product__art {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 250rpx;
  background: #eeede8;
}

.product__image {
  width: 100%;
  height: 100%;
}

.product__emoji {
  font-size: 82rpx;
  line-height: 1;
}

.product__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(20, 24, 21, 0.42);
  color: #fff;
  font-size: 24rpx;
}

.product__body {
  padding: 16rpx 18rpx 18rpx;
}

.product__name {
  display: -webkit-box;
  min-height: 72rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.4;
}

.product__meta {
  margin-top: 2rpx;
}

.product__stock {
  color: var(--muted);
  font-size: 20rpx;
}

.product__stock--low,
.product__stock--out {
  color: var(--danger);
}

.product__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.product__yen {
  margin-right: 2rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.product__add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-size: 34rpx;
  line-height: 1;
}

.product__add.is-disabled {
  background: var(--surface-soft);
  color: var(--muted);
}

.product-skeleton {
  padding-bottom: 18rpx;
  overflow: hidden;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  background: #fff;
}

.product-skeleton__art {
  height: 250rpx;
  border-radius: 0;
}

.product-skeleton__line {
  height: 24rpx;
  margin: 16rpx 18rpx 0;
}

.product-skeleton__line--short {
  width: 55%;
}

.pager {
  display: flex;
  justify-content: center;
  margin: 34rpx 0 6rpx;
}

.pager__text {
  color: var(--muted);
  font-size: 22rpx;
}
