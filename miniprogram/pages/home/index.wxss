.home {
  padding-top: 20rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  background: var(--brand);
  color: var(--accent);
  font-size: 38rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 24rpx rgba(32, 76, 57, 0.22);
}

.brand__name {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.brand__meta {
  margin-top: 2rpx;
  font-size: 17rpx;
  letter-spacing: 3rpx;
  color: var(--muted);
}

.quick {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.quick__btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: 0 8rpx 20rpx rgba(31, 56, 44, 0.06);
}

.quick__btn--hover {
  background: var(--surface-soft);
}

.quick__icon {
  font-size: 30rpx;
  line-height: 1;
}

.quick__badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--danger);
  color: #fff;
  font-size: 18rpx;
  line-height: 32rpx;
  text-align: center;
  font-weight: 700;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 42rpx 34rpx 34rpx;
  border-radius: 36rpx;
  background: linear-gradient(145deg, #24523e 0%, #173a2b 72%);
  color: #fffdf3;
  box-shadow: 0 26rpx 50rpx rgba(23, 58, 43, 0.22);
}

.hero__orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.hero__orb--one {
  width: 320rpx;
  height: 320rpx;
  top: -140rpx;
  right: -90rpx;
  background: radial-gradient(
    circle at center,
    rgba(217, 232, 127, 0.3) 0%,
    rgba(217, 232, 127, 0) 70%
  );
}

.hero__orb--two {
  width: 260rpx;
  height: 260rpx;
  bottom: -170rpx;
  left: -70rpx;
  background: radial-gradient(
    circle at center,
    rgba(255, 253, 243, 0.16) 0%,
    rgba(255, 253, 243, 0) 70%
  );
}

.hero__eyebrow {
  position: relative;
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #c9d7bd;
  font-weight: 600;
}

.hero__title {
  position: relative;
  margin-top: 16rpx;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.18;
  letter-spacing: 1rpx;
}

.hero__title--accent {
  margin-top: 0;
  color: var(--accent);
}

.hero__desc {
  position: relative;
  margin-top: 18rpx;
  max-width: 520rpx;
  font-size: 24rpx;
  line-height: 1.65;
  color: rgba(255, 253, 243, 0.72);
}

.hero__stats {
  position: relative;
  display: flex;
  align-items: flex-end;
  gap: 34rpx;
  margin-top: 32rpx;
}

.hero__stat {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.hero__num {
  font-size: 38rpx;
  font-weight: 800;
  color: #fffdf3;
  font-variant-numeric: tabular-nums;
}

.hero__label {
  font-size: 20rpx;
  color: rgba(255, 253, 243, 0.6);
}

.hero__tag {
  margin-left: auto;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(217, 232, 127, 0.4);
  border-radius: 999rpx;
  font-size: 20rpx;
  color: var(--accent);
  letter-spacing: 1rpx;
}

.search {
  display: flex;
  align-items: center;
  height: 92rpx;
  margin-top: 26rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: 0 10rpx 26rpx rgba(31, 56, 44, 0.06);
}

.search__icon {
  margin-right: 14rpx;
  font-size: 28rpx;
  opacity: 0.7;
}

.search__input {
  flex: 1;
  height: 90rpx;
  font-size: 27rpx;
  color: var(--ink);
}

.search__clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--surface-soft);
  color: var(--muted);
  font-size: 20rpx;
}

.chips {
  margin-top: 14rpx;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.product {
  overflow: hidden;
  border-radius: 26rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: 0 12rpx 28rpx rgba(31, 56, 44, 0.06);
  transition: transform 0.16s ease;
}

.product--hover {
  transform: scale(0.98);
}

.product__art {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 208rpx;
  background: linear-gradient(150deg, #edf0d9 0%, #e3e8d0 100%);
}

.product__image {
  width: 100%;
  height: 100%;
}

.product__emoji {
  font-size: 86rpx;
  line-height: 1;
  filter: drop-shadow(0 10rpx 12rpx rgba(31, 56, 44, 0.12));
}

.product__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(31, 56, 44, 0.42);
  color: #fffdf3;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.product__body {
  padding: 18rpx 20rpx 20rpx;
}

.product__name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 78rpx;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.35;
}

.product__meta {
  margin-top: 6rpx;
}

.product__stock {
  font-size: 20rpx;
  color: var(--muted);
}

.product__stock--low {
  color: var(--warn);
}

.product__stock--out {
  color: var(--danger);
}

.product__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.product__yen {
  margin-right: 2rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.product__add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: var(--accent);
  color: var(--brand-deep);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1;
  box-shadow: 0 8rpx 16rpx rgba(32, 76, 57, 0.16);
}

.product__add.is-disabled {
  background: var(--surface-soft);
  color: var(--muted);
  box-shadow: none;
}

.product-skeleton {
  padding: 0 0 20rpx;
  border-radius: 26rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  overflow: hidden;
}

.product-skeleton__art {
  height: 208rpx;
  border-radius: 0;
}

.product-skeleton__line {
  height: 26rpx;
  margin: 18rpx 20rpx 0;
}

.product-skeleton__line--short {
  width: 55%;
}

.pager {
  display: flex;
  justify-content: center;
  margin: 34rpx 0 6rpx;
}

.pager__text {
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.footer {
  margin-top: 30rpx;
}
