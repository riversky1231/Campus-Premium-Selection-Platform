<view class="wrap"><view class="eyebrow">CAMPUS / WORKSPACE</view><view class="title">好物管理台</view><view class="label">管理员访问令牌（联调阶段）</view><input password="true" value="{{token}}" bindinput="token" placeholder="输入后端配置的 ADMIN_TOKEN"/><view class="row"><button bindtap="login" loading="{{loading}}">连接管理台</button><button class="secondary" bindtap="logout">退出</button></view><button bindtap="create">＋ 新建商品</button><view class="card" wx:for="{{items}}" wx:key="id"><view class="row"><view class="name">{{item.name}}</view><text>{{item.onSale?'在售':'已下架'}}</text></view><view class="price">¥{{item.price}}</view><view class="stock">库存 {{item.stock}}</view><view class="row"><button class="secondary" data-id="{{item.id}}" bindtap="edit">编辑</button><button class="secondary" data-id="{{item.id}}" bindtap="toggle">{{item.onSale?'下架':'上架'}}</button><button data-id="{{item.id}}" bindtap="restock">补库存</button></view></view><button wx:if="{{hasMore}}" bindtap="more" loading="{{loading}}">加载更多商品</button><view class="name">商品分类</view><view wx:for="{{categories}}" wx:key="id" class="row"><text>{{item.name}}</text><button class="secondary" data-id="{{item.id}}" bindtap="rename">改名</button><button class="secondary" data-id="{{item.id}}" bindtap="removeCategory">删除</button></view><input value="{{categoryName}}" bindinput="categoryName" placeholder="新分类名称"/><button bindtap="addCategory">新增分类</button></view>
