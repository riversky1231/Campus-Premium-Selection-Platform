.admin-login__head {
  padding: 20rpx 4rpx 0;
}

.admin-login__card {
  margin-top: 30rpx;
}

.admin-login__toggle {
  font-size: 21rpx;
  color: var(--brand);
  font-weight: 600;
}

.admin-login__submit {
  margin-top: 30rpx;
}

.admin-login__note {
  margin-top: 20rpx;
}

.admin-login__demo {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: var(--surface-soft);
  text-align: center;
  font-size: 22rpx;
  color: var(--brand);
  font-weight: 600;
}

.admin-login__back {
  margin-top: 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
}

.admin-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.admin-head__logout {
  padding-bottom: 6rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.admin-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: var(--surface-soft);
}

.admin-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  height: 92rpx;
  border-radius: 18rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.admin-tab--active {
  background: var(--brand);
  color: #fffdf3;
  box-shadow: 0 10rpx 20rpx rgba(32, 76, 57, 0.18);
}

.admin-tab__icon {
  font-size: 28rpx;
  line-height: 1.1;
}

.admin-toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 24rpx;
}

.admin-search {
  display: flex;
  align-items: center;
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.admin-search__icon {
  margin-right: 10rpx;
  font-size: 24rpx;
  opacity: 0.7;
}

.admin-search__input {
  flex: 1;
  height: 78rpx;
  font-size: 25rpx;
}

.admin-search__clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: var(--surface-soft);
  color: var(--muted);
  font-size: 18rpx;
}

.admin-toolbar__create {
  flex-shrink: 0;
  height: 80rpx;
}

.admin-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 0 4rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.admin-skeletons {
  margin-top: 14rpx;
}

.admin-product {
  display: flex;
  gap: 18rpx;
  margin-top: 14rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: 0 10rpx 24rpx rgba(31, 56, 44, 0.05);
}

.admin-product--skeleton {
  min-height: 150rpx;
}

.admin-product__art {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: linear-gradient(150deg, #edf0d9 0%, #e1e7ce 100%);
  font-size: 52rpx;
}

.admin-product__art-skeleton {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
}

.admin-product__body {
  flex: 1;
  min-width: 0;
}

.admin-product__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.admin-product__name {
  flex: 1;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}

.admin-product__meta {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.admin-product__actions {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

.admin-action {
  padding: 8rpx 18rpx;
  border-radius: 10rpx;
  background: var(--surface-soft);
  font-size: 21rpx;
  color: var(--ink-soft);
}

.admin-action--primary {
  background: var(--accent-soft);
  color: var(--brand);
  font-weight: 600;
}

.admin-action.is-disabled {
  opacity: 0.4;
}

.admin-skeleton__line {
  height: 24rpx;
  margin-bottom: 14rpx;
}

.admin-skeleton__line--short {
  width: 64%;
}

.admin-skeleton__line--tiny {
  width: 40%;
}

.pager {
  display: flex;
  justify-content: center;
  margin: 26rpx 0 6rpx;
}

.pager__text {
  font-size: 22rpx;
  color: var(--muted);
}

.admin-category-add {
  margin-top: 24rpx;
}

.admin-category-add__form {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.admin-category-add__input {
  flex: 1;
}

.admin-category-add__btn {
  width: 150rpx;
  height: 92rpx;
  flex-shrink: 0;
}

.admin-categories {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.admin-category {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.admin-category__name {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
}

.admin-category__actions {
  display: flex;
  gap: 18rpx;
}

.admin-category__action {
  font-size: 21rpx;
  color: var(--brand);
}

.admin-category__action--danger {
  color: var(--danger);
}

.admin-note {
  margin-top: 24rpx;
}

.redeem-card {
  margin-top: 24rpx;
}

.redeem-card__hint {
  margin-top: 6rpx;
}

.redeem-input {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-align: center;
}

.redeem-result {
  margin-top: 20rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: var(--accent-soft);
  border: 1rpx solid rgba(32, 76, 57, 0.18);
}

.redeem-result__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.redeem-result__name {
  margin-top: 14rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.redeem-result__lines {
  margin-top: 12rpx;
}

.redeem-result__line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 4rpx 0;
  font-size: 23rpx;
  color: var(--ink-soft);
}

.redeem-result__line-name {
  flex: 1;
}

.redeem-result__total {
  margin-top: 12rpx;
  text-align: right;
  font-size: 23rpx;
}

.redeem-result__code {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(32, 76, 57, 0.24);
  font-size: 22rpx;
  color: var(--ink-soft);
  letter-spacing: 1rpx;
}

.paid-orders {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.paid-order {
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.paid-order__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.paid-order__code {
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--brand);
  font-variant-numeric: tabular-nums;
}

.paid-order__meta {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.paid-order__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 12rpx;
}

.paid-order__action {
  font-size: 21rpx;
  color: var(--brand);
  font-weight: 600;
}

.admin-users {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.admin-user {
  padding: 22rpx;
  border-radius: 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.admin-user--skeleton {
  min-height: 120rpx;
}

.admin-user__top {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.admin-user__name {
  font-size: 27rpx;
  font-weight: 700;
}

.admin-user__username {
  margin-left: 6rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: var(--muted);
}

.admin-user__meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.admin-user__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--line);
}

.admin-user__balance {
  font-size: 22rpx;
  color: var(--muted);
}

.admin-user__actions {
  display: flex;
  gap: 22rpx;
}

.admin-user__action {
  font-size: 21rpx;
  color: var(--brand);
  font-weight: 600;
}

.admin-user__action--danger {
  color: var(--danger);
}

.admin-user__action.is-disabled {
  opacity: 0.4;
}

.admin-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(21, 53, 40, 0.45);
}

.admin-sheet {
  width: 100%;
  padding: 30rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: var(--surface);
  animation: sheet-up 0.22s ease both;
}

@keyframes sheet-up {
  from {
    transform: translateY(60rpx);
    opacity: 0.6;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.admin-sheet__head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.admin-sheet__hint {
  margin-top: 4rpx;
  line-height: 1.5;
}

.admin-sheet__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--surface-soft);
  color: var(--muted);
  font-size: 22rpx;
}

.admin-sheet__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
