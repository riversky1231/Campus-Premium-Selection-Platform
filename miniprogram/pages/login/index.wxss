.login {
  padding-top: 36rpx;
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.login-brand__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 24rpx 24rpx 24rpx 8rpx;
  background: var(--brand);
  color: var(--accent);
  font-size: 40rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 24rpx rgba(32, 76, 57, 0.22);
}

.login-brand__name {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.login-brand__meta {
  margin-top: 2rpx;
  font-size: 17rpx;
  letter-spacing: 3rpx;
  color: var(--muted);
}

.login-title {
  margin-top: 34rpx;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.16;
  letter-spacing: 1rpx;
}

.login-title--accent {
  margin-top: 0;
  color: var(--brand);
}

.login-desc {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.login-card {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: var(--shadow);
}

.login-tabs {
  display: flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--surface-soft);
}

.login-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  color: var(--muted);
  font-weight: 500;
}

.login-tab--active {
  background: var(--surface);
  color: var(--brand);
  font-weight: 700;
  box-shadow: 0 6rpx 14rpx rgba(31, 56, 44, 0.1);
}

.login-existing {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: var(--accent-soft);
  font-size: 22rpx;
  color: var(--ink-soft);
}

.login-existing__link {
  color: var(--brand);
  font-weight: 700;
}

.login-password-toggle {
  font-size: 21rpx;
  color: var(--brand);
  font-weight: 600;
}

.login-submit {
  margin-top: 32rpx;
}

.login-hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--muted);
}

.login-demo {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--surface-soft);
}

.login-demo__title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink-soft);
  letter-spacing: 1rpx;
}

.login-demo__list {
  margin-top: 14rpx;
}

.login-demo__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 10rpx;
  border-radius: 14rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.login-demo__item--hover {
  background: var(--accent-soft);
}

.login-demo__label {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand);
}

.login-demo__account {
  font-size: 20rpx;
  color: var(--muted);
  text-align: right;
  word-break: break-all;
}

.login-demo__note {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.login-back {
  margin: 34rpx 0 10rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--muted);
}
