.orders-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.orders-head__actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding-bottom: 6rpx;
}

.orders-head__action {
  font-size: 23rpx;
  color: var(--brand);
  font-weight: 600;
}

.orders-head__action--muted {
  color: var(--muted);
  font-weight: 400;
}

.wallet-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(140deg, #24523e 0%, #173a2b 100%);
  color: #fffdf3;
  box-shadow: 0 22rpx 44rpx rgba(23, 58, 43, 0.2);
}

.wallet-card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.wallet-card__label {
  font-size: 22rpx;
  color: rgba(255, 253, 243, 0.62);
  letter-spacing: 1rpx;
}

.wallet-card__amount {
  margin-top: 4rpx;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.wallet-card__yen {
  margin-right: 4rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.wallet-card__user {
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(217, 232, 127, 0.4);
  border-radius: 999rpx;
  color: var(--accent);
  font-size: 20rpx;
}

.wallet-card__hint {
  margin-top: 18rpx;
  font-size: 21rpx;
  color: rgba(255, 253, 243, 0.62);
}

.orders-filters {
  margin-top: 14rpx;
}

.orders-skeleton__card {
  padding: 26rpx;
  margin-bottom: 18rpx;
  border-radius: 26rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.orders-skeleton__line {
  height: 26rpx;
  margin-bottom: 18rpx;
}

.orders-skeleton__line--short {
  width: 38%;
}

.orders-skeleton__block {
  height: 120rpx;
  margin-top: 24rpx;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.order {
  padding: 26rpx;
  border-radius: 28rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  box-shadow: 0 12rpx 28rpx rgba(31, 56, 44, 0.05);
}

.order__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order__time {
  font-size: 21rpx;
  color: var(--muted);
}

.order__no {
  margin-top: 10rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: var(--muted);
}

.order__items {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #faf7ed;
}

.order__line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 0;
  font-size: 25rpx;
}

.order__line-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order__line-qty {
  font-size: 22rpx;
  color: var(--muted);
}

.order__line-price {
  min-width: 110rpx;
  text-align: right;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.order__total {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 18rpx;
}

.order__address {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--line);
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--ink-soft);
}

.order__address-icon {
  font-size: 22rpx;
  line-height: 1.6;
}

.order__address-text {
  flex: 1;
}

.order__countdown {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: var(--warn-soft);
  color: var(--warn);
  font-size: 22rpx;
}

.order__countdown--expired {
  background: var(--danger-soft);
  color: var(--danger);
}

.order__countdown-icon {
  font-size: 22rpx;
}

.pickup {
  margin-top: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: var(--accent-soft);
  border: 1rpx dashed rgba(32, 76, 57, 0.3);
}

.pickup__main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.pickup__label {
  font-size: 21rpx;
  color: var(--ink-soft);
}

.pickup__code {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  color: var(--brand);
  font-variant-numeric: tabular-nums;
}

.pickup__hint {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.order__actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 20rpx;
}

.order__hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.pager {
  display: flex;
  justify-content: center;
  margin: 30rpx 0 6rpx;
}

.pager__text {
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 1rpx;
}

.footer {
  margin-top: 26rpx;
}
