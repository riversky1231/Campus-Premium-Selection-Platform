page {
  --bg: #f5f5f2;
  --surface: #ffffff;
  --surface-soft: #efefeb;
  --surface-deep: #e6e7e1;
  --ink: #272a26;
  --ink-soft: #555b54;
  --muted: #858b83;
  --brand: #f05a28;
  --brand-deep: #d84a1c;
  --accent: #fff0e8;
  --accent-soft: #fff4ee;
  --danger: #df4b3e;
  --danger-soft: #faeae7;
  --warn: #9a6a27;
  --warn-soft: #f5efdf;
  --ok: #397451;
  --ok-soft: #eaf3ec;
  --line: rgba(39, 42, 38, 0.09);
  --line-strong: rgba(39, 42, 38, 0.18);
  --shadow: 0 6rpx 20rpx rgba(39, 42, 38, 0.04);
  background-color: var(--bg);
  color: var(--ink);
  font-family: "PingFang SC", "Helvetica Neue", "Noto Sans SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
}

view,
text,
button,
input,
textarea,
scroll-view,
picker,
label {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: inherit;
  border-radius: 0;
}

button::after {
  border: none;
}

.page {
  min-height: 100vh;
  padding: 28rpx 30rpx calc(48rpx + env(safe-area-inset-bottom));
}

.page--bar {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* ---------- 排版 ---------- */
.eyebrow {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: #7c8a78;
  font-weight: 600;
  text-transform: uppercase;
}

.page-title {
  margin-top: 10rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.16;
  letter-spacing: -1rpx;
  color: var(--ink);
}

.page-subtitle {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: var(--muted);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 38rpx 0 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.section-link {
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.strong {
  font-weight: 700;
}

.link {
  color: var(--brand);
  font-weight: 600;
}

.num {
  font-variant-numeric: tabular-nums;
}

/* ---------- 布局 ---------- */
.row {
  display: flex;
  align-items: center;
}

.row--between {
  justify-content: space-between;
}

.row--gap {
  gap: 16rpx;
}

.row--start {
  align-items: flex-start;
}

.col {
  display: flex;
  flex-direction: column;
}

.grow {
  flex: 1;
  min-width: 0;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 24rpx 0;
}

/* ---------- 卡片 ---------- */
.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 26rpx;
  box-shadow: var(--shadow);
}

.card + .card {
  margin-top: 20rpx;
}

.card--flat {
  box-shadow: none;
}

.card--soft {
  background: var(--surface-soft);
  box-shadow: none;
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0 34rpx;
  border-radius: 12rpx;
  background: var(--brand);
  color: #fffdf3;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.btn--block {
  width: 100%;
}

.btn--ghost {
  background: var(--surface-soft);
  color: var(--brand);
}

.btn--outline {
  background: transparent;
  border: 1rpx solid var(--line-strong);
  color: var(--ink);
}

.btn--danger {
  background: var(--danger-soft);
  color: var(--danger);
}

.btn--sm {
  height: 64rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  border-radius: 14rpx;
  letter-spacing: 0;
}

.btn--xs {
  height: 52rpx;
  padding: 0 18rpx;
  font-size: 22rpx;
  border-radius: 12rpx;
  letter-spacing: 0;
}

.btn[disabled] {
  opacity: 0.45;
}

.btn--hover {
  opacity: 0.86;
  transform: translateY(1rpx);
}

/* ---------- 徽标 ---------- */
.badge {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: var(--surface-soft);
  color: var(--ink-soft);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.badge--ok {
  background: var(--ok-soft);
  color: var(--ok);
}

.badge--warn {
  background: var(--warn-soft);
  color: var(--warn);
}

.badge--danger {
  background: var(--danger-soft);
  color: var(--danger);
}

.badge--muted {
  background: #eceada;
  color: var(--muted);
}

.badge--dark {
  background: var(--brand);
  color: #fffdf3;
}

/* ---------- 表单 ---------- */
.field {
  margin-top: 24rpx;
}

.field__label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ink-soft);
}

.field__hint {
  font-size: 22rpx;
  color: var(--muted);
  font-weight: 400;
}

.input {
  width: 100%;
  height: 92rpx;
  padding: 0 24rpx;
  background: #fbf8ee;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.input--area {
  height: 200rpx;
  padding: 22rpx 24rpx;
  line-height: 1.6;
}

.input--small {
  height: 76rpx;
  font-size: 26rpx;
}

.input-placeholder {
  color: #a6afa0;
}

/* ---------- 分类胶囊 ---------- */
.chips {
  width: 100%;
  height: 92rpx;
  white-space: nowrap;
}

.chips__inner {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 6rpx 0;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: #ece9da;
  color: var(--ink-soft);
  font-size: 25rpx;
  font-weight: 500;
  white-space: nowrap;
}

.chip--active {
  background: var(--brand);
  color: #fffdf3;
  box-shadow: none;
}

/* ---------- 数量步进器 ---------- */
.stepper {
  display: flex;
  align-items: center;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--surface-soft);
}

.stepper__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: var(--surface);
  color: var(--brand);
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1;
  box-shadow: 0 4rpx 10rpx rgba(31, 56, 44, 0.08);
}

.stepper__btn.is-disabled {
  opacity: 0.3;
  box-shadow: none;
}

.stepper__num {
  min-width: 72rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/* ---------- 价格 ---------- */
.price {
  color: var(--danger);
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: -0.5rpx;
  font-variant-numeric: tabular-nums;
}

.price--lg {
  font-size: 44rpx;
}

.price--xl {
  font-size: 54rpx;
}

.price--muted {
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 500;
}

/* ---------- 空状态 / 骨架屏 ---------- */
.empty {
  padding: 90rpx 40rpx;
  text-align: center;
}

.empty__icon {
  font-size: 76rpx;
  line-height: 1;
}

.empty__title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.empty__text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.empty__action {
  display: flex;
  justify-content: center;
  margin-top: 30rpx;
}

.skeleton {
  background: linear-gradient(100deg, #ece7d7 25%, #f7f3e7 37%, #ece7d7 63%);
  background-size: 400% 100%;
  border-radius: 16rpx;
  animation: shimmer 1.4s ease infinite;
}

@keyframes shimmer {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: -100% 0;
  }
}

/* ---------- 底部操作栏 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 253, 247, 0.97);
  border-top: 1rpx solid var(--line);
}

/* ---------- 其他 ---------- */
.fade-in {
  animation: fade-in 0.24s ease both;
}

@keyframes fade-in {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.footer {
  margin: 44rpx 0 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8c9585;
  letter-spacing: 2rpx;
}

.note {
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: var(--surface-soft);
  color: var(--ink-soft);
  font-size: 23rpx;
  line-height: 1.6;
}

.note--warn {
  background: var(--warn-soft);
  color: var(--warn);
}
